#!/usr/bin/env bash
# dephisher — SOC phishing URL triage kit
# Thin wrapper: environment checks, then hand off to the Python CLI.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
    echo "dephisher: error: python3 is required but not found in PATH" >&2
    exit 127
fi

PY_VER="$(python3 -c 'import sys; print("%d%02d" % sys.version_info[:2])')"
if [ "$PY_VER" -lt 309 ]; then
    echo "phish-defend: error: python3 >= 3.9 required (found $(python3 -V 2>&1))" >&2
    exit 127
fi

exec python3 "$SCRIPT_DIR/run.py" "$@"
